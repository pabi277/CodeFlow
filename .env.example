# Local GitHub OAuth testing — copy this file to .env.local and fill in values.
# The client ID is public (safe to commit); the client secret must NEVER be
# committed — .env.local is gitignored.
#
# VITE_GITHUB_CLIENT_ID is inlined into the frontend build.
# GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET are used server-side only, by the
# local /api/exchange dev proxy (see oauthExchangeProxy in vite.config.ts).
VITE_GITHUB_CLIENT_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
